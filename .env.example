# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./aio_students_hub.db

# Authentication
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Demo credentials (development only)
DEMO_STUDENT_EMAIL=student@demo.edu
DEMO_STUDENT_PASSWORD=demo123

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Frontend
FRONTEND_URL=http://localhost:3000